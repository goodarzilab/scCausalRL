experiments/README.md
experiments/*.sbatch
experiments/plot_*.py

# nested duplicate RL/stack trees inside exp20 (canonical copies live at repo root)
experiments/exp20_load_bearing/experiments_rl/
experiments/exp20_load_bearing/docs/
experiments/exp20_load_bearing/runs/
# cluster-specific SLURM launchers (reproduction commands are in README.md)
# keep run_phase1.py — the world-model training entry point
experiments/exp20_load_bearing/scripts/*
!experiments/exp20_load_bearing/scripts/run_phase1.py
experiments_rl/scripts/
# internal sweep bookkeeping
experiments/exp20_load_bearing/configs/briggs_seedcheck_tags.txt
experiments/exp20_load_bearing/configs/briggs_sweep_tags.txt
# keep ONLY the reported Joung+Briggs world-model recipes; drop exploratory sweeps
experiments/exp20_load_bearing/configs/ablations/*
!experiments/exp20_load_bearing/configs/ablations/joungbriggs/
# legacy joint VAE+PPO trainer (superseded by frozen-WM + separate planner)
experiments/exp20_load_bearing/training/train_joint.py
# RL-overlap eval scripts that depend on the retired top-level rl/ package
# (keep rl_gflownet_distribution.py — the reported diversity-at-quality analysis)
experiments/exp20_load_bearing/evaluation/rl_*.py
!experiments/exp20_load_bearing/evaluation/rl_gflownet_distribution.py

